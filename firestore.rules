rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Support tickets can be created by any user (even unauthenticated)
    // but only read, updated, or deleted by administrators.
    match /support_tickets/{ticketId} {
      allow create: if true;
      allow read, update, delete: if request.auth != null &&
        exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    // Admins collection: read by everyone, write allowed temporarily for seeding
    match /admins/{adminId} {
      allow read, write: if true;
    }

    // Default fallback rules for all other collections:
    // Read is allowed for everyone, write requires verified admin role.
    match /{document=**} {
      allow read: if true;
      allow write: if request.auth != null &&
        exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }
  }
}
