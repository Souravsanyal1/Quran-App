rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Helper: checks if the user is an admin
    function isAdmin() {
      return request.auth != null && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    // Helper: validates basic string length
    function isValidString(val, min, max) {
      return val is string && val.size() >= min && val.size() <= max;
    }

    // Support tickets
    match /support_tickets/{ticketId} {
      allow create: if request.auth != null
        && isValidString(request.resource.data.subject, 3, 100)
        && request.resource.data.userId == request.auth.uid;

      allow read, list: if request.auth != null && (
        isAdmin() || resource.data.userId == request.auth.uid
      );

      allow update: if request.auth != null && (
        isAdmin() || (resource.data.userId == request.auth.uid && request.resource.data.userId == request.auth.uid)
      );

      allow delete: if isAdmin();

      match /messages/{messageId} {
        allow create: if request.auth != null;
        allow update: if request.auth != null;
        allow read, list: if request.auth != null && (
          isAdmin() ||
          get(/databases/$(database)/documents/support_tickets/$(ticketId)).data.userId == request.auth.uid
        );
      }
    }

    // User profiles
    match /users/{userId} {
      allow read: if request.auth != null && (request.auth.uid == userId || isAdmin());
      // Users can only write their own profile, admins can manage all
      allow write: if request.auth != null && (request.auth.uid == userId || isAdmin());

      match /notifications/{notificationId} {
        allow read, write: if request.auth != null && (request.auth.uid == userId || isAdmin());
      }
    }

    // Admins collection - ONLY existing admins can add/remove other admins
    match /admins/{adminId} {
      allow read: if request.auth != null;
      allow write: if isAdmin();
    }

    // Configuration & Public Content
    match /banners/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /custom_ads/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /static_top_banners/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /broadcast_notifications/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Global settings and fallbacks
    match /app_settings/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /{document=**} {
      allow read: if true;
      allow write: if isAdmin();
    }
  }
}
